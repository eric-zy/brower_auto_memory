# 复制为 .env 后填写；不要提交真实密钥。
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=deepseek-flash-free

# 中转站 API 地址。
# DeepSeek 使用网页结构和文字，需要服务支持 function calling。
OPENAI_BASE_URL=https://api.teamorouter.cn/v1

# 日常只需 python main.py；预览使用 python main.py --dry-run。
UPLOAD_DIR=E:/upload_test
UPLOAD_HEADLESS=false
UPLOAD_STABLE_SECONDS=30
UPLOAD_MAX_STEPS=80
# 联调先跑一集；设为 0 恢复全部队列。
UPLOAD_MAX_JOBS=1
# 模型单次请求秒数；坏 JSON 最多重新生成一次，网络超时不重复等待。
UPLOAD_REQUEST_TIMEOUT=30
# 单个视频上传完成的等待上限（秒），由程序轮询，不消耗模型调用。
UPLOAD_TIMEOUT=600
# 固定资料填一次，单集 JSON 自动生成；默认项目目录中的 upload_config.json。
# UPLOAD_CONFIG=E:/workSpace/brower-agent-test/upload_config.json
# 默认台账为 UPLOAD_DIR/发布记录.xlsx，状态保存在项目 .kuaishou-upload。
# UPLOAD_LEDGER=E:/upload_test/发布记录.xlsx
# UPLOAD_STATE_DIR=E:/workSpace/brower-agent-test/.kuaishou-upload

# Platform/account isolation and bounded semantic recovery
UPLOAD_PLATFORM=kuaishou
UPLOAD_ACCOUNT_ID=default
UPLOAD_EXPECTED_ACCOUNT=
UPLOAD_RECOVERY_STEPS=2
UPLOAD_USE_VISION=false
